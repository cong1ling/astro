---
interface Props {
	title: string;
	description?: string;
}

const { title, description = '帷幄的个人博客，分享技术、生活与灵感。使用 Astro 构建。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Zhi+Mang+Xing&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<header>
			<nav>

				<div class="nav-links">
					<a href="/">首页</a>
					<a href="/blog">文章</a>
					<a href="/friends">友链</a>
					<a href="/guestbook">留言</a>
					<a href="/about">关于</a>
				</div>
				<button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
					<span class="sun-icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
						</svg>
					</span>
					<span class="moon-icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</span>
				</button>
				<div id="header-status" class="header-status">
					<span id="current-date">加载中...</span>
					<span id="current-region">获取位置...</span>
					<span id="current-weather">获取天气...</span>
				</div>
			</nav>
		</header>
		<div class="main-content">
			<slot />
		</div>
		<footer>
			<div class="footer-content">
				<div class="footer-stats">
					<span class="stat-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
							<circle cx="12" cy="12" r="3"></circle>
						</svg>
						<span>本站总访问量 <span id="busuanzi_value_site_pv">加载中...</span> 次</span>
					</span>
					<span class="stat-divider">|</span>
					<span class="stat-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
							<circle cx="9" cy="7" r="4"></circle>
							<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
						</svg>
						<span>访客数 <span id="busuanzi_value_site_uv">加载中...</span> 人</span>
					</span>
				</div>
				<p>&copy; {new Date().getFullYear()} 帷幄的Blog. All rights reserved.</p>
				<div class="footer-links">
					<a href="/about">关于</a>
					<a href="https://github.com/cong1ling" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="mailto:tanshujian@linux.do,tanshujian131@qq.com" title="发送邮件">Email 邮箱</a>
				</div>
			</div>
		</footer>

		<!-- 回到顶部按钮 -->
		<button id="back-to-top" class="back-to-top" aria-label="回到顶部">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 15l-6-6-6 6"/>
			</svg>
		</button>

		<canvas id="petal-cursor" aria-hidden="true"></canvas>

			<!-- 不蒜子访问量统计 -->
		<script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>

		<!-- Live2D Widget - 简单配置 -->
		<script src="https://fastly.jsdelivr.net/gh/stevenjoezhang/live2d-widget@latest/autoload.js"></script>

		<!-- 鼠标点击特效 -->
		<script is:inline src="/click-effect.js"></script>

			<script is:inline>
				(() => {
					const canvas = document.getElementById('petal-cursor');
					if (!(canvas instanceof HTMLCanvasElement)) return;

					const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
					const coarsePointer = window.matchMedia('(pointer: coarse)');
					if (prefersReducedMotion.matches || coarsePointer.matches) return;

					const ctx = canvas.getContext('2d');
					if (!ctx) return;

					const particles = [];
					const pointer = { x: window.innerWidth / 2, y: window.innerHeight / 2, active: false };
					const DPR = Math.min(window.devicePixelRatio || 1, 2);
					const MAX_PARTICLES = 60;
					const TRAIL_LENGTH = 4;
					const EMIT_INTERVAL = 20;
					const REPULSE_RADIUS = 26;
					const ATTRACT_RADIUS = 132;
					const VORTEX_RADIUS = 136;
					let width = window.innerWidth;
					let height = window.innerHeight;
					let lastTime = performance.now();
					let rafId = 0;
					let lastSpawn = 0;

					// 优化花瓣颜色，使用更淡的粉色系
					const petalColors = [
						'rgba(255, 220, 230, 0.8)',
						'rgba(255, 230, 235, 0.75)',
						'rgba(255, 235, 240, 0.7)',
						'rgba(255, 240, 245, 0.65)',
						'rgba(255, 245, 248, 0.6)',
						'rgba(250, 225, 235, 0.7)',
						'rgba(250, 230, 240, 0.65)'
					];

					function resizeCanvas() {
						width = window.innerWidth;
						height = window.innerHeight;
						canvas.width = Math.floor(width * DPR);
						canvas.height = Math.floor(height * DPR);
						canvas.style.width = `${width}px`;
						canvas.style.height = `${height}px`;
						ctx.setTransform(1, 0, 0, 1, 0, 0);
						ctx.scale(DPR, DPR);
					}

					function rand(min, max) {
						return Math.random() * (max - min) + min;
					}

					function createParticle(x, y, burst = false) {
						// 更自然的飘落角度
						const angle = -Math.PI / 2 + rand(-1.0, 1.0) + Math.PI * 0.1;
						// 减慢速度以增强飘落效果
						const speed = burst ? rand(15, 30) : rand(2, 5);
						const size = rand(4, 7);
						// 延长生命周期使飘落过程更完整
						const life = rand(3.0, 4.5);

						return {
							x,
							y,
							vx: Math.cos(angle) * speed + rand(-3, 3),
							vy: Math.sin(angle) * speed - rand(5, 10),
							ax: 0,
							ay: 0,
							size,
							life,
							maxLife: life,
							rotation: rand(0, Math.PI * 2),
							spin: rand(-0.6, 0.6), // 减慢旋转速度
							color: petalColors[(Math.random() * petalColors.length) | 0],
							trail: [],
							waveOffset: rand(0, Math.PI * 2),
							waveFrequency: rand(0.3, 0.8), // 波浪频率
							waveAmplitude: rand(3, 6), // 波浪幅度
							swayOffset: rand(0, Math.PI * 2), // 左右摇摆偏移
							swayFrequency: rand(0.2, 0.5), // 摇摆频率
							swayAmplitude: rand(1, 3) // 摇摆幅度
						};
					}

					function spawn(x, y, count) {
						for (let i = 0; i < count; i++) {
							if (particles.length >= MAX_PARTICLES) particles.shift();
							particles.push(createParticle(x + rand(-14, 14), y + rand(-14, 14), true));
						}
					}

					function drawPetal(x, y, size, rotation, alpha, color) {
						ctx.save();
						ctx.translate(x, y);
						ctx.rotate(rotation);
						ctx.scale(1, 0.82);
						ctx.globalAlpha = alpha;
						ctx.fillStyle = color;
						ctx.beginPath();
						ctx.moveTo(0, -size * 0.9);
						ctx.bezierCurveTo(size * 0.95, -size * 0.65, size * 0.9, size * 0.65, 0, size);
						ctx.bezierCurveTo(-size * 0.9, size * 0.65, -size * 0.95, -size * 0.65, 0, -size * 0.9);
						ctx.fill();

						ctx.globalAlpha = alpha * 0.35;
						ctx.fillStyle = 'white';
						ctx.beginPath();
						ctx.ellipse(size * 0.12, -size * 0.1, size * 0.16, size * 0.35, -0.35, 0, Math.PI * 2);
						ctx.fill();
						ctx.restore();
					}

					function update(dt) {
						for (let i = particles.length - 1; i >= 0; i--) {
							const p = particles[i];
							const dx = pointer.x - p.x;
							const dy = pointer.y - p.y;
							const dist = Math.hypot(dx, dy) || 1;

							// 更自然的重力效果（向下飘落）
							p.ay = 20;

							// 空气阻力
							p.vx *= Math.pow(0.92, dt * 60);
							p.vy *= Math.pow(0.92, dt * 60);

							// 鼠标交互效果
							if (pointer.active) {
								if (dist < REPULSE_RADIUS) {
									const force = (REPULSE_RADIUS - dist) * 12;
									p.ax -= (dx / dist) * force;
									p.ay -= (dy / dist) * force;
								}

								if (dist < ATTRACT_RADIUS) {
									const pull = (ATTRACT_RADIUS - dist) * 1.2;
									p.ax += (dx / dist) * pull;
									p.ay += (dy / dist) * pull * 0.8;
								}

								if (dist < VORTEX_RADIUS) {
									const swirl = (VORTEX_RADIUS - dist) * 2.5;
									p.ax += (-dy / dist) * swirl;
									p.ay += (dx / dist) * swirl;
								}
							}

							// 波浪运动
							p.x += Math.sin(p.waveOffset + p.waveFrequency * p.life) * p.waveAmplitude * dt * 60;
							p.waveOffset += dt * 1.5;

							// 左右摇摆效果
							p.x += Math.sin(p.swayOffset + p.swayFrequency * p.life) * p.swayAmplitude * dt * 60;
							p.swayOffset += dt * 1.2;

							// 更新速度和位置
							p.vx += p.ax * dt;
							p.vy += p.ay * dt;

							p.x += p.vx * dt;
							p.y += p.vy * dt;
							p.rotation += p.spin * dt;
							p.life -= dt;

							// 花瓣大小随时间变化
							const sizeFactor = 1 - (p.life / p.maxLife) * 0.3;
							p.currentSize = p.size * sizeFactor;

							// 更新轨迹
							p.trail.push({ x: p.x, y: p.y, size: p.currentSize || p.size, life: p.life / p.maxLife });
							if (p.trail.length > TRAIL_LENGTH) p.trail.shift();

							// 移除生命周期结束的粒子
							if (p.life <= 0 || p.y < -100 || p.y > height + 100 || p.x < -100 || p.x > width + 100) {
								particles.splice(i, 1);
							}
						}
					}

					function render() {
						ctx.clearRect(0, 0, width, height);

						for (const p of particles) {
							// 绘制轨迹
							for (let i = 0; i < p.trail.length; i++) {
								const t = p.trail[i];
								const alpha = ((i + 1) / p.trail.length) * 0.15 * t.life;
								drawPetal(t.x, t.y, t.size * (0.5 + (i / p.trail.length) * 0.3), p.rotation, alpha, p.color);
							}

							// 绘制当前粒子
							const alpha = Math.max(0, Math.min(1, p.life / p.maxLife));
							drawPetal(p.x, p.y, p.currentSize || p.size, p.rotation, alpha, p.color);
						}
					}

					function frame(now) {
						const dt = Math.min((now - lastTime) / 1000, 0.033);
						lastTime = now;
						update(dt);
						render();
						rafId = window.requestAnimationFrame(frame);
					}

					function onPointerMove(event) {
						pointer.x = event.clientX;
						pointer.y = event.clientY;
						pointer.active = true;

						const now = performance.now();
						if (now - lastSpawn > EMIT_INTERVAL) {
							spawn(pointer.x, pointer.y, 1);
							lastSpawn = now;
						}
					}

					function onPointerLeave() {
						pointer.active = false;
					}

					function onPointerDown(event) {
						pointer.x = event.clientX;
						pointer.y = event.clientY;
						pointer.active = true;
						spawn(pointer.x, pointer.y, 3);
					}

					function cleanup() {
						window.cancelAnimationFrame(rafId);
						window.removeEventListener('resize', resizeCanvas);
						window.removeEventListener('pointermove', onPointerMove);
						window.removeEventListener('pointerleave', onPointerLeave);
						window.removeEventListener('pointerdown', onPointerDown);
						window.removeEventListener('pagehide', cleanup);
					}

					resizeCanvas();
					window.addEventListener('resize', resizeCanvas);
					window.addEventListener('pointermove', onPointerMove, { passive: true });
					window.addEventListener('pointerleave', onPointerLeave);
					window.addEventListener('pointerdown', onPointerDown, { passive: true });
					window.addEventListener('pagehide', cleanup);

					rafId = window.requestAnimationFrame(frame);
				})();
			</script>

		<script is:inline>
			// Theme Logic
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
				document.documentElement.setAttribute('data-theme', 'light');
			} else {
				document.documentElement.classList.add('dark');
				document.documentElement.setAttribute('data-theme', 'dark');
			}

			window.localStorage.setItem('theme', theme);

			const handleToggleClick = () => {
				const element = document.documentElement;
				element.classList.toggle("dark");

				const isDark = element.classList.contains("dark");
				const newTheme = isDark ? "dark" : "light";
				element.setAttribute('data-theme', newTheme);
				localStorage.setItem("theme", newTheme);
			};

			document.getElementById("theme-toggle").addEventListener("click", handleToggleClick);

			// Real-time Date & Weather Logic...
			function updateDate() {
				const now = new Date();
				const options = { month: 'long', day: 'numeric', weekday: 'short' };
				document.getElementById('current-date').textContent = now.toLocaleDateString('zh-CN', options);
			}

			let weatherRetryCount = 0;
			const maxRetries = 3;
			const fallbackWeather = {
				region: '本地',
				temp: '20',
				desc: '晴'
			};

			async function updateWeather() {
				const weatherEl = document.getElementById('current-weather');
				const regionEl = document.getElementById('current-region');
				
				try {
					const controller = new AbortController();
					const timeoutId = setTimeout(() => controller.abort(), 5000);
					
					const response = await fetch('https://wttr.in/?format=j1', {
						signal: controller.signal
					});
					
					clearTimeout(timeoutId);
					
					if (response.ok) {
						const data = await response.json();
						const current = data.current_condition[0];
						const area = data.nearest_area[0];
						
						regionEl.textContent = area.areaName[0].value || '未知地区';
						const temp = current.temp_C;
						const weatherDesc = current.lang_zh[0]?.value || current.weatherDesc[0].value;
						weatherEl.textContent = `${weatherDesc} ${temp}°C`;
						
						weatherRetryCount = 0;
						
						if (window.showMessage) {
							if (weatherDesc.includes('雨') || weatherDesc.includes('Rain')) {
								window.showMessage('外面好像在下雨呢，记得带伞哦~', 5000);
							} else if (weatherDesc.includes('晴') || weatherDesc.includes('Sun')) {
								window.showMessage('天气真好，一起去散步吧！', 5000);
							}
						}
					} else {
						throw new Error(`HTTP ${response.status}`);
					}
				} catch (e) {
					console.log('天气API请求失败:', e.message);
					
					if (weatherRetryCount < maxRetries) {
						weatherRetryCount++;
						console.log(`天气API重试 ${weatherRetryCount}/${maxRetries}`);
						setTimeout(updateWeather, 2000 * weatherRetryCount);
					} else {
						weatherEl.textContent = `${fallbackWeather.desc} ${fallbackWeather.temp}°C`;
						regionEl.textContent = fallbackWeather.region;
						weatherRetryCount = 0;
					}
				}
			}

			// Initial call and refresh
			updateDate();
			updateWeather();
			setInterval(updateDate, 60000); // Update time every minute

			// 回到顶部按钮逻辑
			const backToTopBtn = document.getElementById('back-to-top');
			
			// 监听滚动事件
			window.addEventListener('scroll', () => {
				if (window.scrollY > 300) {
					backToTopBtn.classList.add('visible');
				} else {
					backToTopBtn.classList.remove('visible');
				}
			});

			// 点击回到顶部
			backToTopBtn.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});
		</script>
	</body>
</html>
<style is:global>
	:root {
		/* Professional, Human-Centric Palette */
		--c-primary: #2563eb;      /* Royal Blue - Trustworthy, Professional */
		--c-primary-light: #3b82f6;
		--c-primary-dark: #1d4ed8;
		
		--c-secondary: #dc2626;    /* Red - Energy, Attention */
		--c-secondary-light: #ef4444;
		--c-secondary-dark: #b91c1c;
		
		--c-accent: #059669;       /* Emerald Green - Growth, Success */
		--c-accent-light: #10b981;
		
		--c-success: #10b981;      /* Green */
		--c-warning: #d97706;      /* Amber */
		--c-info: #0ea5e9;         /* Sky Blue */

		--c-brand: var(--c-primary);
		--c-brand-light: var(--c-primary-light);
		--c-brand-dark: var(--c-primary-dark);
		
		--c-text: #0f172a;         /* Slate 900 - Deep, Readable */
		--c-text-secondary: #475569; /* Slate 600 - Secondary Text */
		--c-text-light: #64748b;   /* Slate 500 - Muted Text */
		
		--c-background: #ffffff;
		--c-surface: #f8fafc;      /* Slate 50 - Subtle Background */
		--c-card-bg: rgba(255, 255, 255, 0.85);
		--c-card-border: #e2e8f0;  /* Slate 200 - Clean Border */
		
		--shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
		--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
		--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		--shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
		--shadow-2xl: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
		
		--radius-sm: 8px;
		--radius-md: 12px;
		--radius-lg: 16px;
		--radius-xl: 20px;
		--radius-2xl: 24px;
		--radius-full: 9999px;
		
		--spacing-xs: 0.5rem;
		--spacing-sm: 0.75rem;

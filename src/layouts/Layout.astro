---
interface Props {
	title: string;
	description?: string;
}

const { title, description = '言西早木的个人博客，分享技术、生活与灵感。使用 Astro 构建。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@300;400;500;600;700&family=Zhi+Mang+Xing&family=Noto+Sans+SC:wght@300;400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<header>
			<nav>
				<a href="/" class="nav-brand">言西<span>早木</span></a>
				<div class="nav-links">
					<a href="/">首页</a>
					<a href="/blog">文章</a>
					<a href="/friends">友链</a>
					<a href="/guestbook">留言</a>
					<a href="/about">关于</a>
				</div>
				<button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
					<span class="sun-icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="5"></circle>
							<line x1="12" y1="1" x2="12" y2="3"></line>
							<line x1="12" y1="21" x2="12" y2="23"></line>
							<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
							<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
							<line x1="1" y1="12" x2="3" y2="12"></line>
							<line x1="21" y1="12" x2="23" y2="12"></line>
							<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
							<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
						</svg>
					</span>
					<span class="moon-icon">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
						</svg>
					</span>
				</button>
				<div id="header-status" class="header-status">
					<span id="current-date">加载中...</span>
					<span id="current-region">获取位置...</span>
					<span id="current-weather">获取天气...</span>
				</div>
			</nav>
		</header>
		<div class="main-content">
			<slot />
		</div>
		<footer>
			<div class="footer-content">
				<div class="footer-stats">
					<span class="stat-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
							<circle cx="12" cy="12" r="3"></circle>
						</svg>
						<span>本站总访问量 <span id="busuanzi_value_site_pv">加载中...</span> 次</span>
					</span>
					<span class="stat-divider">|</span>
					<span class="stat-item">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
							<circle cx="9" cy="7" r="4"></circle>
							<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
							<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
						</svg>
						<span>访客数 <span id="busuanzi_value_site_uv">加载中...</span> 人</span>
					</span>
				</div>
				<p>&copy; {new Date().getFullYear()} 言西早木的Blog. All rights reserved.</p>
				<div class="footer-links">
					<a href="/about">关于</a>
					<a href="https://github.com/cong1ling" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="mailto:tanshujian@linux.do,tanshujian131@qq.com" title="发送邮件">Email 邮箱</a>
				</div>
			</div>
		</footer>

		<!-- 回到顶部按钮 -->
		<button id="back-to-top" class="back-to-top" aria-label="回到顶部">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 15l-6-6-6 6"/>
			</svg>
		</button>

		<!-- 不蒜子访问量统计 -->
		<script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>

		<!-- Live2D Widget - Koharu Model -->
		<script src="https://fastly.jsdelivr.net/gh/stevenjoezhang/live2d-widget@latest/autoload.js"></script>
		<script is:inline>
			// 等待 Live2D 加载完成后切换到 koharu 模型
			function loadKoharuModel() {
				if (typeof loadlive2d === 'function') {
					loadlive2d('live2d', 'https://unpkg.com/live2d-widget-model-koharu@1.0.5/assets/koharu.model.json');
					console.log('Koharu 模型已加载');
				} else {
					setTimeout(loadKoharuModel, 500);
				}
			}
			setTimeout(loadKoharuModel, 3000);
		</script>
		
		<!-- Live2D Custom Config -->
		<script is:inline src="/live2d-custom-config.js"></script>

		<!-- 鼠标点击特效 -->
		<script is:inline src="/click-effect.js"></script>

		<script is:inline>
			// Theme Logic
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
				document.documentElement.setAttribute('data-theme', 'light');
			} else {
				document.documentElement.classList.add('dark');
				document.documentElement.setAttribute('data-theme', 'dark');
			}

			window.localStorage.setItem('theme', theme);

			const handleToggleClick = () => {
				const element = document.documentElement;
				element.classList.toggle("dark");

				const isDark = element.classList.contains("dark");
				const newTheme = isDark ? "dark" : "light";
				element.setAttribute('data-theme', newTheme);
				localStorage.setItem("theme", newTheme);
			};

			document.getElementById("theme-toggle").addEventListener("click", handleToggleClick);

			// Real-time Date & Weather Logic...
			function updateDate() {
				const now = new Date();
				const options = { month: 'long', day: 'numeric', weekday: 'short' };
				document.getElementById('current-date').textContent = now.toLocaleDateString('zh-CN', options);
			}

			let weatherRetryCount = 0;
			const maxRetries = 3;
			const fallbackWeather = {
				region: '本地',
				temp: '20',
				desc: '晴'
			};

			async function updateWeather() {
				const weatherEl = document.getElementById('current-weather');
				const regionEl = document.getElementById('current-region');
				
				try {
					const controller = new AbortController();
					const timeoutId = setTimeout(() => controller.abort(), 5000);
					
					const response = await fetch('https://wttr.in/?format=j1', {
						signal: controller.signal
					});
					
					clearTimeout(timeoutId);
					
					if (response.ok) {
						const data = await response.json();
						const current = data.current_condition[0];
						const area = data.nearest_area[0];
						
						regionEl.textContent = area.areaName[0].value || '未知地区';
						const temp = current.temp_C;
						const weatherDesc = current.lang_zh[0]?.value || current.weatherDesc[0].value;
						weatherEl.textContent = `${weatherDesc} ${temp}°C`;
						
						weatherRetryCount = 0;
						
						if (window.showMessage) {
							if (weatherDesc.includes('雨') || weatherDesc.includes('Rain')) {
								window.showMessage('外面好像在下雨呢，记得带伞哦~', 5000);
							} else if (weatherDesc.includes('晴') || weatherDesc.includes('Sun')) {
								window.showMessage('天气真好，一起去散步吧！', 5000);
							}
						}
					} else {
						throw new Error(`HTTP ${response.status}`);
					}
				} catch (e) {
					console.log('天气API请求失败:', e.message);
					
					if (weatherRetryCount < maxRetries) {
						weatherRetryCount++;
						console.log(`天气API重试 ${weatherRetryCount}/${maxRetries}`);
						setTimeout(updateWeather, 2000 * weatherRetryCount);
					} else {
						weatherEl.textContent = `${fallbackWeather.desc} ${fallbackWeather.temp}°C`;
						regionEl.textContent = fallbackWeather.region;
						weatherRetryCount = 0;
					}
				}
			}

			// Initial call and refresh
			updateDate();
			updateWeather();
			setInterval(updateDate, 60000); // Update time every minute

			// 回到顶部按钮逻辑
			const backToTopBtn = document.getElementById('back-to-top');
			
			// 监听滚动事件
			window.addEventListener('scroll', () => {
				if (window.scrollY > 300) {
					backToTopBtn.classList.add('visible');
				} else {
					backToTopBtn.classList.remove('visible');
				}
			});

			// 点击回到顶部
			backToTopBtn.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});
		</script>
	</body>
</html>
<style is:global>
	:root {
		/* Professional, Human-Centric Palette */
		--c-primary: #2563eb;      /* Royal Blue - Trustworthy, Professional */
		--c-primary-light: #3b82f6;
		--c-primary-dark: #1d4ed8;
		
		--c-secondary: #dc2626;    /* Red - Energy, Attention */
		--c-secondary-light: #ef4444;
		--c-secondary-dark: #b91c1c;
		
		--c-accent: #059669;       /* Emerald Green - Growth, Success */
		--c-accent-light: #10b981;
		
		--c-success: #10b981;      /* Green */
		--c-warning: #d97706;      /* Amber */
		--c-info: #0ea5e9;         /* Sky Blue */

		--c-brand: var(--c-primary);
		--c-brand-light: var(--c-primary-light);
		--c-brand-dark: var(--c-primary-dark);
		
		--c-text: #0f172a;         /* Slate 900 - Deep, Readable */
		--c-text-secondary: #475569; /* Slate 600 - Secondary Text */
		--c-text-light: #64748b;   /* Slate 500 - Muted Text */
		
		--c-background: #ffffff;
		--c-surface: #f8fafc;      /* Slate 50 - Subtle Background */
		--c-card-bg: rgba(255, 255, 255, 0.85);
		--c-card-border: #e2e8f0;  /* Slate 200 - Clean Border */
		
		--shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
		--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
		--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		--shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
		--shadow-2xl: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
		
		--radius-sm: 8px;
		--radius-md: 12px;
		--radius-lg: 16px;
		--radius-xl: 20px;
		--radius-2xl: 24px;
		--radius-full: 9999px;
		
		--spacing-xs: 0.5rem;
		--spacing-sm: 0.75rem;
		--spacing-md: 1rem;
		--spacing-lg: 1.5rem;
		--spacing-xl: 2rem;
		--spacing-2xl: 3rem;
		
		/* Typography */
		--font-family-base: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', sans-serif;
		--font-family-display: 'Inter', 'Noto Sans SC', sans-serif;
		--font-special: 'Zhi Mang Xing', cursive;
		
		--font-size-xs: 0.75rem;
		--font-size-sm: 0.875rem;
		--font-size-base: 1rem;
		--font-size-lg: 1.125rem;
		--font-size-xl: 1.25rem;
		--font-size-2xl: 1.5rem;
		--font-size-3xl: 1.875rem;
		--font-size-4xl: 2.25rem;
		--font-size-5xl: 3rem;
	}
	
	html[data-theme='dark'] {
		--c-primary: #60a5fa;
		--c-primary-light: #93c5fd;
		--c-primary-dark: #3b82f6;
		
		--c-secondary: #f87171;
		--c-secondary-light: #fca5a5;
		--c-secondary-dark: #ef4444;
		
		--c-accent: #34d399;
		--c-accent-light: #6ee7b7;
		
		--c-brand: var(--c-primary);
		--c-brand-light: var(--c-primary-light);
		--c-brand-dark: var(--c-primary-dark);
		
		--c-text: #f1f5f9;         /* Slate 100 */
		--c-text-secondary: #cbd5e1; /* Slate 300 */
		--c-text-light: #94a3b8;   /* Slate 400 */
		
		--c-background: #0f172a;   /* Slate 900 */
		--c-surface: #1e293b;      /* Slate 800 */
		--c-card-bg: rgba(30, 41, 59, 0.85);
		--c-card-border: #475569;  /* Slate 600 */
		
		--shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
		--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
		--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
		--shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.6);
		--shadow-2xl: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
	}
	
	html {
		font-family: var(--font-family-base);
		background: var(--c-background);
		color: var(--c-text);
		line-height: 1.6;
		transition: background 0.3s ease, color 0.3s ease;
		scroll-behavior: smooth;
	}
	
	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		overflow-x: hidden;
		background: var(--c-background);
		display: flex;
		flex-direction: column;
		position: relative;
	}

	/* Light mode gradient background */
	body::before {
		content: '';
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: 
			radial-gradient(circle at 20% 20%, rgba(99, 102, 241, 0.08), transparent 50%),
			radial-gradient(circle at 80% 80%, rgba(236, 72, 153, 0.08), transparent 50%),
			radial-gradient(circle at 50% 50%, rgba(139, 92, 246, 0.05), transparent 50%);
		z-index: -2;
		pointer-events: none;
	}

	body::after {
		content: '';
		position: fixed;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background: 
			radial-gradient(circle at 30% 40%, rgba(99, 102, 241, 0.06), transparent 40%),
			radial-gradient(circle at 70% 60%, rgba(236, 72, 153, 0.06), transparent 40%);
		animation: rotate-gradient 30s linear infinite;
		z-index: -1;
		pointer-events: none;
	}

	html[data-theme='dark'] body::before {
		background: 
			radial-gradient(circle at 20% 20%, rgba(129, 140, 248, 0.15), transparent 50%),
			radial-gradient(circle at 80% 80%, rgba(244, 114, 182, 0.15), transparent 50%),
			radial-gradient(circle at 50% 50%, rgba(167, 139, 250, 0.1), transparent 50%);
	}

	html[data-theme='dark'] body::after {
		background: 
			radial-gradient(circle at 30% 40%, rgba(129, 140, 248, 0.1), transparent 40%),
			radial-gradient(circle at 70% 60%, rgba(244, 114, 182, 0.1), transparent 40%);
	}

	@keyframes rotate-gradient {
		0% { transform: rotate(0deg); }
		100% { transform: rotate(360deg); }
	}
	
	header {
		padding: 1rem 1.5rem;
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: var(--shadow-sm);
		border-bottom: 1px solid var(--c-card-border);
		transition: all 0.3s ease;
	}

	html[data-theme='dark'] header {
		background: rgba(15, 23, 42, 0.8);
		border-bottom-color: var(--c-card-border);
		box-shadow: var(--shadow-md);
	}

	nav {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}
	
	.nav-brand {
		font-family: var(--font-family-display);
		font-weight: 700;
		font-size: var(--font-size-xl);
		color: var(--c-text);
		text-decoration: none;
		letter-spacing: -0.02em;
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	
	.nav-brand:hover {
		transform: translateY(-1px);
	}
	
	.nav-brand span {
		background: linear-gradient(135deg, var(--c-primary), var(--c-secondary));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.nav-links {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}
	
	.nav-links a {
		text-decoration: none;
		color: var(--c-text-secondary);
		font-weight: 500;
		font-size: var(--font-size-sm);
		padding: 0.5rem 1rem;
		border-radius: var(--radius-full);
		transition: all 0.2s ease;
		position: relative;
	}
	
	.nav-links a::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--c-surface);
		border-radius: var(--radius-full);
		opacity: 0;
		transition: opacity 0.2s ease;
		z-index: -1;
	}
	
	.nav-links a:hover {
		color: var(--c-primary);
	}
	
	.nav-links a:hover::before {
		opacity: 1;
	}

	html[data-theme='dark'] .nav-links a {
		color: var(--c-text-secondary);
	}

	html[data-theme='dark'] .nav-links a::before {
		background: var(--c-surface);
	}

	html[data-theme='dark'] .nav-links a:hover {
		color: var(--c-primary-light);
	}

	.main-content {
		flex: 1 0 auto;
	}

	.theme-toggle {
		background: var(--c-surface);
		border: 1px solid var(--c-card-border);
		width: 36px;
		height: 36px;
		border-radius: var(--radius-full);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
		transition: all 0.2s ease;
		padding: 0;
		box-shadow: var(--shadow-sm);
	}

	.theme-toggle:hover {
		transform: scale(1.05);
		box-shadow: var(--shadow-md);
	}

	.sun-icon { display: block; }
	.moon-icon { display: none; }

	html[data-theme='dark'] .sun-icon { display: none; }
	html[data-theme='dark'] .moon-icon { display: block; }
	
	.header-status {
		display: flex;
		gap: 1rem;
		font-size: var(--font-size-xs);
		color: var(--c-text-light);
		padding-left: 1rem;
		border-left: 1px solid var(--c-card-border);
	}

	@media (max-width: 768px) {
		.header-status {
			display: none;
		}
		
		nav {
			gap: 1rem;
		}
		
		.nav-links {
			gap: 0.25rem;
		}
		
		.nav-links a {
			padding: 0.4rem 0.8rem;
			font-size: var(--font-size-xs);
		}
	}
	
	footer {
		margin-top: auto;
		padding: 2rem 1rem;
		background: rgba(255, 255, 255, 0.6);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-top: 1px solid var(--c-card-border);
		text-align: center;
	}

	html[data-theme='dark'] footer {
		background: rgba(15, 23, 42, 0.6);
	}
	
	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		color: var(--c-text-light);
		gap: 1rem;
		font-size: var(--font-size-sm);
	}

	.footer-stats {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.5rem 1rem;
		background: var(--c-surface);
		border-radius: var(--radius-full);
		border: 1px solid var(--c-card-border);
	}

	.stat-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--c-text-secondary);
	}

	.stat-item svg {
		color: var(--c-primary);
		flex-shrink: 0;
	}

	.stat-item span {
		font-size: var(--font-size-xs);
	}

	.stat-item span span {
		font-weight: 600;
		color: var(--c-primary);
	}

	.stat-divider {
		color: var(--c-card-border);
	}

	.footer-links {
		display: flex;
		gap: 1.5rem;
	}

	.footer-links a {
		color: var(--c-text-light);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-links a:hover {
		color: var(--c-primary);
	}

	@media (max-width: 640px) {
		.footer-stats {
			flex-direction: column;
			gap: 0.5rem;
		}

		.stat-divider {
			display: none;
		}
	}

	code {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,

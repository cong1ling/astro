		--font-family-display: 'Inter', 'Noto Sans SC', sans-serif;
		--font-special: 'Zhi Mang Xing', cursive;
		
		--font-size-xs: 0.75rem;
		--font-size-sm: 0.875rem;
		--font-size-base: 1rem;
		--font-size-lg: 1.125rem;
		--font-size-xl: 1.25rem;
		--font-size-2xl: 1.5rem;
		--font-size-3xl: 1.875rem;
		--font-size-4xl: 2.25rem;
		--font-size-5xl: 3rem;
	}
	
	html[data-theme='dark'] {
		--c-primary: #60a5fa;
		--c-primary-light: #93c5fd;
		--c-primary-dark: #3b82f6;
		
		--c-secondary: #f87171;
		--c-secondary-light: #fca5a5;
		--c-secondary-dark: #ef4444;
		
		--c-accent: #34d399;
		--c-accent-light: #6ee7b7;
		
		--c-brand: var(--c-primary);
		--c-brand-light: var(--c-primary-light);
		--c-brand-dark: var(--c-primary-dark);
		
		--c-text: #f1f5f9;         /* Slate 100 */
		--c-text-secondary: #cbd5e1; /* Slate 300 */
		--c-text-light: #94a3b8;   /* Slate 400 */
		
		--c-background: #0f172a;   /* Slate 900 */
		--c-surface: #1e293b;      /* Slate 800 */
		--c-card-bg: rgba(30, 41, 59, 0.85);
		--c-card-border: #475569;  /* Slate 600 */
		
		--shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.3);
		--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);

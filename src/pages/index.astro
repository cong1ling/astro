<script is:inline>
	/**
	 * Hero 语录轮播
	 * 背景改为流体动画，只保留语录的轮播切换
	 */
	const heroCarousel = document.querySelector('[data-hero-carousel]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (heroCarousel) {
		const quotes = Array.from(heroCarousel.querySelectorAll('[data-hero-quote]'));
		const total = quotes.length;
		let currentIndex = 0;
		let autoplayId;
		const autoplayDelay = 5500;

		const setActiveSlide = (index) => {
			currentIndex = (index + total) % total;

			quotes.forEach((quote, quoteIndex) => {
				const isActive = quoteIndex === currentIndex;
				quote.classList.toggle('is-active', isActive);
				quote.setAttribute('aria-hidden', String(!isActive));
			});
		};

		const stopAutoplay = () => {
			if (autoplayId) {
				window.clearInterval(autoplayId);
			}
		};

		const startAutoplay = () => {
			if (prefersReducedMotion || total <= 1) return;
			stopAutoplay();
			autoplayId = window.setInterval(() => {
				setActiveSlide(currentIndex + 1);
			}, autoplayDelay);
		};

		setActiveSlide(0);
		startAutoplay();
	}

	// 同步状态栏
	function syncStatus() {
		const hDate = document.getElementById('hero-date');
		const hRegion = document.getElementById('hero-region');
		const hWeather = document.getElementById('hero-weather');
		
		const gDate = document.getElementById('current-date');
		const gRegion = document.getElementById('current-region');
		const gWeather = document.getElementById('current-weather');
		
		if (hDate && gDate) hDate.textContent = gDate.textContent;
		if (hRegion && gRegion) hRegion.textContent = gRegion.textContent;
		if (hWeather && gWeather) hWeather.textContent = gWeather.textContent;
	}

	// 卡片鼠标跟随效果
	document.querySelectorAll('.nav-card').forEach(card => {
		card.addEventListener('mousemove', (e) => {
			const rect = card.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 100;
			const y = ((e.clientY - rect.top) / rect.height) * 100;
			card.style.setProperty('--mouse-x', `${x}%`);
			card.style.setProperty('--mouse-y', `${y}%`);
		});
	});

	// 游戏卡片点击展开
	const gameCard = document.getElementById('gameCard');
	const gameDropdown = document.getElementById('gameDropdown');
	
	if (gameCard && gameDropdown) {
		gameCard.addEventListener('click', (e) => {
			if (e.target.closest('.game-item')) return;
			e.stopPropagation();
			gameDropdown.classList.toggle('show');
		});

		document.addEventListener('click', (e) => {
			if (!gameCard.contains(e.target)) {
				gameDropdown.classList.remove('show');
			}
		});
	}

	// 初始化
	setTimeout(syncStatus, 500);
	setInterval(syncStatus, 2000);
</script>

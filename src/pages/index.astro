---
import Layout from '../layouts/Layout.astro';
import FluidBackground from '../components/FluidBackground.astro';

const heroQuotes = [
	'运筹帷幄之中，决胜千里之外',
	'山高路远，见世界，也见自己',
	'在霓虹与代码之间，也要保留热爱',
	'愿每一次出发，都能抵达心中所向'
];
---

<Layout title="欢迎来到帷幄的博客">
	<main>
		<!-- 全屏沉浸式 Hero -->
		<div class="immersive-hero" data-hero-carousel>
			<FluidBackground />
			<div class="hero-gradient-overlay"></div>
			
			<div class="hero-content-wrapper">
				<div class="hero-avatar">
					<img src="https://cdn.jsdelivr.net/gh/cong1ling/yanxizaomu-images@main/blog/img/1772426717500-4io3hz.jpg" alt="Avatar" draggable="false" />
					<div class="avatar-ring"></div>
				</div>
				
				<h1 class="hero-title">
					<span class="title-main">帷幄</span>
					<span class="title-sub">Code · Life · Dream</span>
				</h1>
				
				<div class="hero-description">
					<div class="hero-quote-carousel" aria-live="polite">
						{heroQuotes.map((quote, index) => (
							<p
								class={`hero-quote-item${index === 0 ? ' is-active' : ''}`}
								data-hero-quote
								aria-hidden={index === 0 ? 'false' : 'true'}
							>
								{quote}
							</p>
						))}
					</div>
				</div>

				<div class="hero-social">
					<a href="https://github.com/cong1ling" target="_blank" rel="noopener noreferrer" class="social-link" title="GitHub">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>
					<a href="mailto:tanshujian@linux.do" class="social-link" title="Email">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
					</a>
					<a href="/blog" class="social-link" title="博客">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
							<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
						</svg>
					</a>
				</div>

				

				<div class="scroll-indicator">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</div>
			</div>
		</div>

		<!-- 内容区域 -->
		<div class="content-section">
			<!-- 状态栏 -->
			<div class="status-bar">
				<div class="status-item">
					<svg class="status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
					</svg>
					<span id="hero-date">...</span>
				</div>
				<div class="status-item">
					<svg class="status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<span id="hero-region">获取位置...</span>
				</div>
				<div class="status-item">
					<svg class="status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M23 6l-9.5 9.5-5-5L1 18"></path>
						<polyline points="17 6 23 6 23 12"></polyline>
					</svg>
					<span id="hero-weather">获取天气...</span>
				</div>
			</div>

			<!-- 快速导航 -->
			<div class="quick-nav">
				<h2 class="section-title">
					<svg class="title-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 2L2 7l10 5 10-5-10-5z"></path>
						<path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
					</svg>
					<span>快速导航</span>
				</h2>
				
				<div class="nav-grid">
					<a href="/blog" class="nav-card nav-card-featured">
						<div class="nav-card-surface">
							<div class="nav-card-pattern"></div>
							<div class="nav-card-glow"></div>
							<div class="nav-card-content">
								<div class="card-icon-wrapper">
									<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
										<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
									</svg>
								</div>
								<div class="nav-card-copy">
									<h3>文章列表</h3>
									<p>阅读最新的技术文章和学习笔记</p>
								</div>
							</div>
							<div class="card-hover-effect"></div>
						</div>
					</a>

					<a href="/about" class="nav-card nav-card-featured">
						<div class="nav-card-surface">
							<div class="nav-card-pattern"></div>
							<div class="nav-card-glow"></div>
							<div class="nav-card-content">
								<div class="card-icon-wrapper">
									<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
										<circle cx="12" cy="7" r="4"></circle>
									</svg>
								</div>
								<div class="nav-card-copy">
									<h3>关于我</h3>
									<p>了解更多关于我以及这个项目的信息</p>
								</div>
							</div>
							<div class="card-hover-effect"></div>
						</div>
					</a>

					<a href="/guestbook" class="nav-card">
						<div class="nav-card-surface">
							<div class="nav-card-pattern"></div>
							<div class="nav-card-glow"></div>
							<div class="nav-card-content">
								<div class="card-icon-wrapper">
									<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
									</svg>
								</div>
								<div class="nav-card-copy">
									<h3>留言板</h3>
									<p>在这里留下你的足迹和想法</p>
								</div>
							</div>
							<div class="card-hover-effect"></div>
						</div>
					</a>



					<div class="nav-card game-card" id="gameCard">
						<div class="nav-card-surface">
							<div class="nav-card-pattern"></div>
							<div class="nav-card-glow"></div>
							<div class="nav-card-content">
								<div class="card-icon-wrapper">
									<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<rect x="2" y="6" width="20" height="12" rx="2"></rect>
										<circle cx="8" cy="12" r="2"></circle>
										<line x1="14" y1="10" x2="14" y2="14"></line>
										<line x1="12" y1="12" x2="16" y2="12"></line>
									</svg>
								</div>
								<div class="nav-card-copy">
									<h3>小游戏</h3>
									<p>点击展开游戏列表，放松一下</p>
								</div>
							</div>
							<div class="card-hover-effect"></div>
						</div>
						<div class="game-dropdown" id="gameDropdown">
							<a href="/games/shooter" class="game-item">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<circle cx="12" cy="12" r="10"></circle>
									<circle cx="12" cy="12" r="6"></circle>
									<circle cx="12" cy="12" r="2"></circle>
								</svg>
								<span>射击小游戏</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	main {
		padding: 0;
		margin: 0;
	}

	/* 全屏沉浸式 Hero */
	.immersive-hero {
		position: relative;
		height: clamp(620px, 70vh, 760px);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.hero-gradient-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			rgba(0, 0, 0, 0.15) 0%,
			rgba(0, 0, 0, 0.1) 100%
		);
		pointer-events: none;
		z-index: 1;
	}

	html[data-theme='dark'] .hero-gradient-overlay {
		background: linear-gradient(
			135deg,
			rgba(0, 0, 0, 0.25) 0%,
			rgba(0, 0, 0, 0.15) 100%
		);
	}

	.hero-content-wrapper {
		position: relative;
		z-index: 1;
		text-align: center;
		color: white;
		width: min(100%, 960px);
		margin: 0 auto;
		padding: 1.5rem 2rem 1rem;
		animation: fade-in-up 1s ease-out;
	}

	@keyframes fade-in-up {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 头像 */
	.hero-avatar {
		position: relative;
		width: 104px;
		height: 104px;
		margin: 0 auto 1.5rem;
		animation: float 3s ease-in-out infinite;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	.hero-avatar img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid rgba(255, 255, 255, 0.3);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
		user-select: none;
		-webkit-user-select: none;
		-webkit-user-drag: none;
		-webkit-touch-callout: none;
	}

	.avatar-ring {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		border: 2px solid rgba(255, 255, 255, 0.5);
		animation: pulse-ring 2s ease-out infinite;
	}

	@keyframes pulse-ring {
		0% {
			transform: scale(1);
			opacity: 1;
		}
		100% {
			transform: scale(1.2);
			opacity: 0;
		}
	}

	/* 标题 */
	.hero-title {
		margin: 0 0 1rem 0;
		color: #fff;
		mix-blend-mode: difference;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
	}

	.title-main {
		display: block;
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 700;
		margin-bottom: 0.5rem;
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
	}

	.title-sub {
		display: block;
		font-size: clamp(1rem, 2vw, 1.25rem);
		font-weight: 400;
		opacity: 0.95;
		letter-spacing: 0.2em;
	}

	/* 描述 */
	.hero-description {
		max-width: 640px;
		margin: 0 auto 1.5rem;
		line-height: 1.8;
	}

	.hero-description p {
		margin: 0.5rem 0;
	}

	.hero-quote-carousel {
		position: relative;
		min-height: 4.2rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-quote-item {
		position: absolute;
		left: 50%;
		top: 50%;
		width: min(100%, 34rem);
		margin: 0;
		transform: translate(-50%, calc(-50% + 12px));
		opacity: 0;
		font-family: 'STKaiti', 'KaiTi', '楷体', serif;
		font-size: clamp(1.35rem, 3.4vw, 2.3rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.5;
		color: #fff;
		text-align: center;
		mix-blend-mode: difference;
		text-shadow:
			0 2px 6px rgba(0, 0, 0, 0.32),
			0 8px 24px rgba(37, 99, 235, 0.18);
			transition: opacity 0.6s ease, transform 0.6s ease;
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
	}

	.hero-quote-item.is-active {
		opacity: 1;
		transform: translate(-50%, -50%);
	}

	/* 社交链接 */
	.hero-social {
		display: flex;
		gap: 1rem;
		justify-content: center;
		margin-bottom: 1.5rem;
	}

	.hero-carousel-controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.hero-control {
		width: 44px;
		height: 44px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.28);
		background: rgba(255, 255, 255, 0.12);
		color: white;
		border-radius: 50%;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		cursor: pointer;
		transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
	}

	.hero-control:hover {
		transform: translateY(-2px);
		background: rgba(255, 255, 255, 0.2);
		border-color: rgba(255, 255, 255, 0.46);
	}

	.hero-carousel-dots {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.hero-dot {
		width: 10px;
		height: 10px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.34);
		cursor: pointer;
		transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
	}

	.hero-dot:hover {
		background: rgba(255, 255, 255, 0.58);
		transform: scale(1.08);
	}

	.hero-dot.is-active {
		width: 10px;
		background: rgba(255, 255, 255, 0.96);
		transform: scale(1.2);
		box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.12);
	}

	.social-link {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 50%;
		color: white;
		text-decoration: none;
		transition: all 0.3s ease;
		border: 1px solid rgba(255, 255, 255, 0.3);
	}

	.social-link:hover {
		background: rgba(255, 255, 255, 0.3);
		transform: translateY(-4px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
	}

	/* 滚动指示器 */
	.scroll-indicator {
		position: absolute;
		bottom: 1.25rem;
		left: 50%;
		transform: translateX(-50%);
		color: #fff;
		mix-blend-mode: difference;
		animation: bounce 2s ease-in-out infinite;
		opacity: 0.8;
	}

	@supports not (mix-blend-mode: difference) {
		.hero-title,
		.hero-quote-item,
		.scroll-indicator {
			color: #0f172a;
		}

		html[data-theme='dark'] .hero-title,
		html[data-theme='dark'] .hero-quote-item,
		html[data-theme='dark'] .scroll-indicator {
			color: #fff;
		}
	}

	@keyframes bounce {
		0%, 100% { transform: translateX(-50%) translateY(0); }
		50% { transform: translateX(-50%) translateY(10px); }
	}

	/* 内容区域 */
	.content-section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1rem;
	}

	/* 状态栏 */
	.status-bar {
		display: flex;
		justify-content: center;
		gap: 2rem;
		flex-wrap: wrap;
		margin-bottom: 4rem;
		padding: 1.5rem;
		background: var(--c-card-bg);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid var(--c-card-border);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-md);
	}

	.status-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--font-size-sm);
		color: var(--c-text-secondary);
	}

	.status-icon {
		color: var(--c-primary);
	}

	/* 快速导航 */
	.quick-nav {
		margin-bottom: 4rem;
	}

	.section-title {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		font-size: var(--font-size-3xl);
		font-weight: 700;
		color: var(--c-text);
		margin: 0 0 3rem 0;
	}

	.title-icon {
		color: var(--c-primary);
		flex-shrink: 0;
	}

	.nav-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		perspective: 1400px;
	}

	.nav-card {
		position: relative;
		display: block;
		text-decoration: none;
		color: var(--c-text);
		cursor: pointer;
		transform-style: preserve-3d;
		transition: transform 0.45s ease, filter 0.45s ease;
		filter: drop-shadow(0 18px 26px rgba(15, 23, 42, 0.08));
	}

	.nav-card-surface {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 240px;
		padding: 2rem;
		background:
			linear-gradient(145deg, rgba(248, 250, 252, 0.84), rgba(235, 243, 252, 0.72)),
			radial-gradient(circle at top left, rgba(59, 130, 246, 0.1), transparent 42%);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		border: 1px solid rgba(148, 163, 184, 0.2);
		border-radius: var(--radius-xl);
		box-shadow:
			0 14px 30px rgba(15, 23, 42, 0.08),
			0 1px 0 rgba(255, 255, 255, 0.5) inset;
		overflow: hidden;
		transform-style: preserve-3d;
		transition:
			transform 0.5s ease,
			box-shadow 0.45s ease,
			border-color 0.45s ease,
			background-position 0.6s ease;
	}


	.nav-card-pattern,
	.nav-card-glow,
	.card-hover-effect {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.nav-card-pattern {
		background:
			linear-gradient(135deg, transparent 18.75%, rgba(59, 130, 246, 0.05) 0 31.25%, transparent 0),
			repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.14) -6.25% 6.25%, rgba(191, 219, 254, 0.08) 0 18.75%);
		background-size: 52px 52px;
		opacity: 0.55;
		mix-blend-mode: soft-light;
		transform: translateZ(8px);
		transition: background-position 0.6s ease, opacity 0.45s ease;
	}

	.nav-card-glow {
		background:
			radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.1), transparent 28%),
			radial-gradient(circle at 80% 0%, rgba(255, 255, 255, 0.28), transparent 24%);
		opacity: 0.72;
		transform: translateZ(16px);
		transition: opacity 0.45s ease, transform 0.45s ease;
	}


	.nav-card-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		height: 100%;
		transform-style: preserve-3d;
	}

	.nav-card-copy {

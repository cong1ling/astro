---
import Layout from '../layouts/Layout.astro';
---

<Layout title="欢迎来到言西早木的博客">
	<main>
		<!-- 全屏沉浸式 Hero -->
		<div class="immersive-hero">
			<div class="hero-bg">
				<div class="hero-image-layer"></div>
				<div class="hero-gradient-overlay"></div>
			</div>
			
			<div class="hero-content-wrapper">
				<div class="hero-avatar">
					<img src="https://cdn.jsdelivr.net/gh/cong1ling/yanxizaomu-images@main/blog/img/preview.gif" alt="Avatar" />
					<div class="avatar-ring"></div>
				</div>
				
				<h1 class="hero-title">
					<span class="title-main">言西早木</span>
					<span class="title-sub">Code · Life · Dream</span>
				</h1>
				
				<div class="hero-description">
					<p id="hitokoto-text">正在聆听宇宙的低语...</p>
					<p id="hitokoto-from" class="hitokoto-source"></p>
				</div>

				<div class="hero-social">
					<a href="https://github.com/cong1ling" target="_blank" rel="noopener noreferrer" class="social-link" title="GitHub">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>
					<a href="mailto:tanshujian@linux.do" class="social-link" title="Email">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
					</a>
					<a href="/blog" class="social-link" title="博客">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
							<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
						</svg>
					</a>
				</div>

				<div class="scroll-indicator">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</div>
			</div>
		</div>

		<!-- 内容区域 -->
		<div class="content-section">
			<!-- 状态栏 -->
			<div class="status-bar">
				<div class="status-item">
					<svg class="status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
						<line x1="16" y1="2" x2="16" y2="6"></line>
						<line x1="8" y1="2" x2="8" y2="6"></line>
						<line x1="3" y1="10" x2="21" y2="10"></line>
					</svg>
					<span id="hero-date">...</span>
				</div>
				<div class="status-item">
					<svg class="status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<span id="hero-region">获取位置...</span>
				</div>
				<div class="status-item">
					<svg class="status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M23 6l-9.5 9.5-5-5L1 18"></path>
						<polyline points="17 6 23 6 23 12"></polyline>
					</svg>
					<span id="hero-weather">获取天气...</span>
				</div>
			</div>

			<!-- 快速导航 -->
			<div class="quick-nav">
				<h2 class="section-title">
					<svg class="title-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 2L2 7l10 5 10-5-10-5z"></path>
						<path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
					</svg>
					<span>快速导航</span>
				</h2>
				
				<div class="nav-grid">
					<a href="/blog" class="nav-card">
						<div class="card-icon-wrapper">
							<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
								<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
							</svg>
						</div>
						<h3>文章列表</h3>
						<p>阅读最新的技术文章和学习笔记</p>
						<div class="card-hover-effect"></div>
					</a>

					<a href="/about" class="nav-card">
						<div class="card-icon-wrapper">
							<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
								<circle cx="12" cy="7" r="4"></circle>
							</svg>
						</div>
						<h3>关于我</h3>
						<p>了解更多关于我以及这个项目的信息</p>
						<div class="card-hover-effect"></div>
					</a>

					<a href="/guestbook" class="nav-card">
						<div class="card-icon-wrapper">
							<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
							</svg>
						</div>
						<h3>留言板</h3>
						<p>在这里留下你的足迹和想法</p>
						<div class="card-hover-effect"></div>
					</a>

					<a href="https://linux.do" target="_blank" rel="noopener noreferrer" class="nav-card">
						<div class="card-icon-wrapper">
							<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
								<circle cx="9" cy="7" r="4"></circle>
								<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
								<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
							</svg>
						</div>
						<h3>Linux.do 社区</h3>
						<p>重现互联网精神，加入充满活力的技术社区</p>
						<div class="card-hover-effect"></div>
					</a>

					<div class="nav-card game-card" id="gameCard">
						<div class="card-icon-wrapper">
							<svg class="card-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="2" y="6" width="20" height="12" rx="2"></rect>
								<circle cx="8" cy="12" r="2"></circle>
								<line x1="14" y1="10" x2="14" y2="14"></line>
								<line x1="12" y1="12" x2="16" y2="12"></line>
							</svg>
						</div>
						<h3>小游戏</h3>
						<p>点击展开游戏列表，放松一下</p>
						<div class="card-hover-effect"></div>
						<div class="game-dropdown" id="gameDropdown">
							<a href="/games/shooter" class="game-item">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<circle cx="12" cy="12" r="10"></circle>
									<circle cx="12" cy="12" r="6"></circle>
									<circle cx="12" cy="12" r="2"></circle>
								</svg>
								<span>射击小游戏</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	main {
		padding: 0;
		margin: 0;
	}

	/* 全屏沉浸式 Hero */
	.immersive-hero {
		position: relative;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-image-layer {
		position: absolute;
		inset: 0;
		background: url("https://cdn.jsdelivr.net/gh/cong1ling/yanxizaomu-images@main/blog/img/樱花刀姬_水畔剪影.png") center/cover no-repeat;
		animation: ken-burns 30s ease-in-out infinite alternate;
	}

	@keyframes ken-burns {
		0% { transform: scale(1) translateX(0); }
		100% { transform: scale(1.1) translateX(-20px); }
	}

	.hero-gradient-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			rgba(37, 99, 235, 0.85) 0%,
			rgba(59, 130, 246, 0.85) 100%
		);
	}

	html[data-theme='dark'] .hero-gradient-overlay {
		background: linear-gradient(
			135deg,
			rgba(37, 99, 235, 0.9) 0%,
			rgba(59, 130, 246, 0.9) 100%
		);
	}

	.hero-content-wrapper {
		position: relative;
		z-index: 1;
		text-align: center;
		color: white;
		padding: 2rem;
		animation: fade-in-up 1s ease-out;
	}

	@keyframes fade-in-up {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 头像 */
	.hero-avatar {
		position: relative;
		width: 120px;
		height: 120px;
		margin: 0 auto 2rem;
		animation: float 3s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	.hero-avatar img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid rgba(255, 255, 255, 0.3);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
	}

	.avatar-ring {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		border: 2px solid rgba(255, 255, 255, 0.5);
		animation: pulse-ring 2s ease-out infinite;
	}

	@keyframes pulse-ring {
		0% {
			transform: scale(1);
			opacity: 1;
		}
		100% {
			transform: scale(1.2);
			opacity: 0;
		}
	}

	/* 标题 */
	.hero-title {
		margin: 0 0 1.5rem 0;
	}

	.title-main {
		display: block;
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 700;
		margin-bottom: 0.5rem;
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
	}

	.title-sub {
		display: block;
		font-size: clamp(1rem, 2vw, 1.25rem);
		font-weight: 400;
		opacity: 0.95;
		letter-spacing: 0.2em;
	}

	/* 描述 */
	.hero-description {
		max-width: 600px;
		margin: 0 auto 2rem;
		font-size: var(--font-size-lg);
		line-height: 1.8;
	}

	.hero-description p {
		margin: 0.5rem 0;
	}

	.hitokoto-source {
		font-size: var(--font-size-sm);
		opacity: 0.8;
		font-style: italic;
	}

	/* 社交链接 */
	.hero-social {
		display: flex;
		gap: 1rem;
		justify-content: center;
		margin-bottom: 3rem;
	}

	.social-link {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 50%;
		color: white;
		text-decoration: none;
		transition: all 0.3s ease;
		border: 1px solid rgba(255, 255, 255, 0.3);
	}

	.social-link:hover {
		background: rgba(255, 255, 255, 0.3);
		transform: translateY(-4px);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
	}

	/* 滚动指示器 */
	.scroll-indicator {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		animation: bounce 2s ease-in-out infinite;
		opacity: 0.8;
	}

	@keyframes bounce {
		0%, 100% { transform: translateX(-50%) translateY(0); }
		50% { transform: translateX(-50%) translateY(10px); }
	}

	/* 内容区域 */
	.content-section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 1rem;
	}

	/* 状态栏 */
	.status-bar {
		display: flex;
		justify-content: center;
		gap: 2rem;
		flex-wrap: wrap;
		margin-bottom: 4rem;
		padding: 1.5rem;
		background: var(--c-card-bg);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid var(--c-card-border);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-md);
	}

	.status-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--font-size-sm);
		color: var(--c-text-secondary);
	}

	.status-icon {
		color: var(--c-primary);
	}

	/* 快速导航 */
	.quick-nav {
		margin-bottom: 4rem;
	}

	.section-title {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		font-size: var(--font-size-3xl);
		font-weight: 700;
		color: var(--c-text);
		margin: 0 0 3rem 0;
	}

	.title-icon {
		color: var(--c-primary);
		flex-shrink: 0;
	}

	.nav-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.nav-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 2rem;
		background: var(--c-card-bg);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid var(--c-card-border);
		border-radius: var(--radius-xl);
		text-decoration: none;
		color: var(--c-text);
		transition: all 0.3s ease;
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}

	.nav-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--c-primary), var(--c-secondary));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s ease;
	}

	.nav-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-2xl);
		border-color: var(--c-primary);
	}

	.nav-card:hover::before {
		transform: scaleX(1);
	}

	.card-icon-wrapper {
		width: 64px;
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
		border-radius: var(--radius-lg);
		margin-bottom: 1.5rem;
		transition: all 0.3s ease;
	}

	.nav-card:hover .card-icon-wrapper {
		transform: scale(1.1) rotate(5deg);
		background: linear-gradient(135deg, var(--c-primary-dark), var(--c-primary));
	}

	.card-icon {
		color: white;
	}

	.nav-card h3 {
		font-size: var(--font-size-xl);
		font-weight: 600;
		color: var(--c-text);
		margin: 0 0 0.75rem 0;
		transition: color 0.3s ease;
	}

	.nav-card:hover h3 {
		color: var(--c-primary);
	}

	.nav-card p {
		font-size: var(--font-size-sm);
		color: var(--c-text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.card-hover-effect {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(37, 99, 235, 0.1), transparent 50%);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
	}

	.nav-card:hover .card-hover-effect {
		opacity: 1;
	}

	/* 响应式 */
	@media (max-width: 768px) {
		.immersive-hero {
			height: 100svh;
		}

		.hero-avatar {
			width: 100px;
			height: 100px;
		}

		.status-bar {
			flex-direction: column;
			gap: 1rem;
		}

		.nav-grid {
			grid-template-columns: 1fr;
		}

		.content-section {
			padding: 2rem 1rem;
		}
	}

	/* 游戏卡片样式 */
	.game-card {
		position: relative;
		cursor: pointer;
		overflow: visible;
	}

	.game-dropdown {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		margin-top: 0.5rem;
		background: var(--c-card-bg);
		border: 1px solid var(--c-card-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xl);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-10px);
		transition: all 0.3s ease;
		z-index: 100;
		overflow: hidden;
	}

	.game-dropdown.show {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.game-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1rem 1.25rem;
		color: var(--c-text);
		text-decoration: none;
		transition: all 0.2s ease;
		border-bottom: 1px solid var(--c-card-border);
	}

	.game-item:last-child {
		border-bottom: none;
	}

	.game-item:hover {
		background: var(--c-primary);
		color: white;
	}

	.game-item svg {
		flex-shrink: 0;
	}

	.game-item span {
		font-size: var(--font-size-sm);
		font-weight: 500;
	}
</style>

<script is:inline>
	// 一言API
	let quoteRetryCount = 0;
	const maxQuoteRetries = 3;
	const fallbackQuotes = [
		{ text: '纵使前路漫漫，亦要砥砺前行。', from: '言西早木' },
		{ text: '代码如诗，记录如酒。', from: '言西早木' },
		{ text: '学习是一场永无止境的旅程。', from: '言西早木' },
		{ text: '保持热爱，奔赴山海。', from: '言西早木' }
	];

	async function updateQuote() {
		const textEl = document.getElementById('hitokoto-text');
		const fromEl = document.getElementById('hitokoto-from');
		
		try {
			const controller = new AbortController();
			const timeoutId = setTimeout(() => controller.abort(), 5000);
			
			const response = await fetch('https://v1.hitokoto.cn/', {
				signal: controller.signal
			});
			
			clearTimeout(timeoutId);
			
			if (response.ok) {
				const data = await response.json();
				textEl.textContent = data.hitokoto;
				fromEl.textContent = `—— 「 ${data.from} 」`;
				quoteRetryCount = 0;
			} else {
				throw new Error(`HTTP ${response.status}`);
			}
		} catch (e) {
			console.log('一言API请求失败:', e.message);
			
			if (quoteRetryCount < maxQuoteRetries) {
				quoteRetryCount++;
				setTimeout(updateQuote, 2000 * quoteRetryCount);
				return;
			}
			
			const fallback = fallbackQuotes[Math.floor(Math.random() * fallbackQuotes.length)];
			textEl.textContent = fallback.text;
			fromEl.textContent = `—— 「 ${fallback.from} 」`;
			quoteRetryCount = 0;
		}
	}

	// 同步状态栏
	function syncStatus() {
		const hDate = document.getElementById('hero-date');
		const hRegion = document.getElementById('hero-region');
		const hWeather = document.getElementById('hero-weather');
		
		const gDate = document.getElementById('current-date');
		const gRegion = document.getElementById('current-region');
		const gWeather = document.getElementById('current-weather');
		
		if (hDate && gDate) hDate.textContent = gDate.textContent;
		if (hRegion && gRegion) hRegion.textContent = gRegion.textContent;
		if (hWeather && gWeather) hWeather.textContent = gWeather.textContent;
	}

	// 卡片鼠标跟随效果
	document.querySelectorAll('.nav-card').forEach(card => {
		card.addEventListener('mousemove', (e) => {
			const rect = card.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width) * 100;
			const y = ((e.clientY - rect.top) / rect.height) * 100;
			card.style.setProperty('--mouse-x', `${x}%`);
			card.style.setProperty('--mouse-y', `${y}%`);
		});
	});

	// 游戏卡片点击展开
	const gameCard = document.getElementById('gameCard');
	const gameDropdown = document.getElementById('gameDropdown');
	
	if (gameCard && gameDropdown) {
		gameCard.addEventListener('click', (e) => {
			if (e.target.closest('.game-item')) return;
			e.stopPropagation();
			gameDropdown.classList.toggle('show');
		});

		document.addEventListener('click', (e) => {
			if (!gameCard.contains(e.target)) {
				gameDropdown.classList.remove('show');
			}
		});
	}

	// 初始化
	updateQuote();
	setInterval(updateQuote, 10000);
	setTimeout(syncStatus, 500);
	setInterval(syncStatus, 2000);
</script>

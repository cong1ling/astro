---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 计算阅读时长（按每分钟200字计算）
function calculateReadingTime(text: string): number {
	const wordsPerMinute = 200;
	const textLength = text ? text.replace(/<[^>]*>/g, '').length : 0;
	return Math.ceil(textLength / wordsPerMinute);
}

// 为每篇文章计算阅读时长（使用描述或标题作为替代）
const postsWithReadingTime = sortedPosts.map((post) => {
	// 使用文章描述或标题作为文本源来计算阅读时长
	const text = post.data.description || post.data.title || '';
	const readingTime = calculateReadingTime(text);
	
	return {
		...post,
		readingTime
	};
});

// 所有文章
const regularPosts = postsWithReadingTime;
---

<Layout title="文章 - Astro Blog" description="帷幄的博客文章列表，分享技术、生活与灵感。">
	<main>
		<!-- Hero Section with Background Image -->
		<div class="blog-hero">
			<div class="hero-overlay"></div>
			<div class="hero-content">
				<h1>
					<span class="hero-subtitle">探索</span>
					<span class="hero-title">我的<span class="text-gradient">文章</span></span>
				</h1>
				<p class="hero-description">分享技术见解、学习笔记与生活感悟</p>
				<div class="hero-stats">
					<div class="stat">
						<span class="stat-number">{allPosts.length}</span>
						<span class="stat-label">篇文章</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat">
						<span class="stat-number">{new Set(allPosts.flatMap(p => p.data.tags || [])).size}</span>
						<span class="stat-label">个标签</span>
					</div>
					<div class="stat-divider"></div>
					<div class="stat">
						<span class="stat-number">{new Date().getFullYear()}</span>
						<span class="stat-label">持续更新</span>
					</div>
				</div>
			</div>
		</div>

		<!-- All Posts -->
		<section class="posts-section">
			<div class="section-header">
				<h2>所有文章</h2>
				<p>按时间倒序排列</p>
			</div>
			
			<!-- 搜索框 -->
			<div class="search-container">
				<div class="search-wrapper">
					<svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input 
						type="text" 
						id="searchInput" 
						placeholder="搜索文章标题或标签..." 
						class="search-input"
					/>
					<button id="clearSearch" class="clear-search" style="display: none;">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
			</div>
			
			<ul role="list" class="link-card-grid" id="postsGrid">
				{regularPosts.map((post, index) => (
					<li 
						class="post-card" 
						data-title={post.data.title.toLowerCase()}
						data-tags={(post.data.tags || []).join(' ').toLowerCase()}
						data-description={post.data.description.toLowerCase()}
						data-index={index}
					>
						<Card 
							href={`/posts/${post.slug}`}
							title={post.data.title}
							body={post.data.description}
							date={post.data.pubDate}
							tags={post.data.tags}
							readingTime={post.readingTime}
						/>
					</li>
				))}
				{regularPosts.length === 0 && (
				<Card 
					href="#"
					title="暂无文章"
					body="请稍后再来查看。"
				/>
			)}
			</ul>

			<!-- 分页导航 -->
			<div class="pagination" id="pagination">
				<button class="pagination-btn prev" id="prevBtn" disabled>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					<span>上一页</span>
				</button>
				<div class="pagination-info">
					<span id="currentPage">1</span> / <span id="totalPages">1</span>
				</div>
				<button class="pagination-btn next" id="nextBtn">
					<span>下一页</span>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</button>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0;
	}

	/* Hero Section */
	.blog-hero {
		position: relative;
		height: 60vh;
		min-height: 400px;
		max-height: 600px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: linear-gradient(135deg, var(--c-primary), var(--c-secondary));
		margin-bottom: 4rem;
	}

	.blog-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: url("https://cdn.jsdelivr.net/gh/cong1ling/yanxizaomu-images@main/blog/img/望云少女_铁道道口.jpg") center/cover no-repeat;
		opacity: 0.25;
		z-index: 0;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(37, 99, 235, 0.85), rgba(59, 130, 246, 0.85));
		z-index: 1;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		text-align: center;
		color: white;
		padding: 2rem;
		max-width: 800px;
	}

	.hero-subtitle {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.9;
		margin-bottom: 0.5rem;
	}

	.hero-title {
		display: block;
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 700;
		line-height: 1.2;
		margin-bottom: 1rem;
	}

	.text-gradient {
		background: linear-gradient(135deg, #ffffff, rgba(255, 255, 255, 0.9));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-description {
		font-size: var(--font-size-lg);
		opacity: 0.95;
		margin-bottom: 2rem;
		font-weight: 300;
	}

	.hero-stats {
		display: inline-flex;
		gap: 2rem;
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		padding: 1.5rem 3rem;
		border-radius: var(--radius-full);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.stat-number {
		font-size: var(--font-size-3xl);
		font-weight: 700;
		line-height: 1;
	}

	.stat-label {
		font-size: var(--font-size-xs);
		opacity: 0.9;
		font-weight: 500;
	}

	.stat-divider {
		width: 1px;
		height: 40px;
		background: rgba(255, 255, 255, 0.3);
	}

	/* Section Headers */
	.section-header {
		text-align: center;
		margin-bottom: 3rem;
		padding: 0 1rem;
	}

	.section-header h2 {
		font-size: var(--font-size-3xl);
		font-weight: 700;
		color: var(--c-text);
		margin: 0 0 0.5rem 0;
	}

	.section-header p {
		font-size: var(--font-size-base);
		color: var(--c-text-secondary);
		margin: 0;
	}

	/* Posts Section */
	.posts-section {
		padding: 0 1rem 4rem;
	}

	/* Search Container */
	.search-container {
		max-width: 1200px;
		margin: 0 auto 2rem;
		padding: 0 1rem;
	}

	.search-wrapper {
		position: relative;
		display: flex;
		align-items: center;
		background: var(--c-card-bg);
		border: 1px solid var(--c-card-border);
		border-radius: 50px;
		padding: 0.5rem 1rem;
		box-shadow: var(--shadow-md);
	}

	.search-wrapper:focus-within {
		border-color: var(--c-primary);
		box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		color: var(--c-text-light);
		pointer-events: none;
		flex-shrink: 0;
	}

	.search-input {
		width: 100%;
		padding: 0.5rem 2.5rem 0.5rem 2.5rem;
		border: none;
		background: transparent;
		font-size: 1rem;
		color: var(--c-text);
		outline: none;
	}

	.search-input::placeholder {
		color: var(--c-text-light);
		opacity: 0.7;
	}

	.clear-search {
		position: absolute;
		right: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		background: var(--c-surface);
		border: 1px solid var(--c-card-border);
		border-radius: 50%;
		color: var(--c-text-light);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.clear-search:hover {
		background: var(--c-primary);
		color: white;
		border-color: var(--c-primary);
	}

	.clear-search svg {
		width: 12px;
		height: 12px;
	}

	.post-card {
		list-style: none;
		transition: opacity 0.3s ease;
	}

	.post-card[style*="display: none"] {
		display: none !important;
	}
	
	.link-card-grid {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 0;
		list-style: none;
		max-width: 900px;
		margin: 0 auto;
	}

	/* Pagination */
	.pagination {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2rem;
		margin-top: 3rem;
		padding: 2rem 1rem;
		max-width: 900px;
		margin-left: auto;
		margin-right: auto;
	}

	.pagination-btn {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: var(--c-surface);
		border: 1px solid var(--c-card-border);
		border-radius: var(--radius-lg);
		color: var(--c-text);
		font-size: var(--font-size-sm);
		font-weight: 500;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.pagination-btn:hover:not(:disabled) {
		background: var(--c-primary);
		color: white;
		border-color: var(--c-primary);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.pagination-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.pagination-btn svg {
		flex-shrink: 0;
	}

	.pagination-info {
		font-size: var(--font-size-lg);
		font-weight: 600;
		color: var(--c-text);
		min-width: 80px;
		text-align: center;
	}

	.pagination-info span {
		color: var(--c-primary);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.blog-hero {
			height: 50vh;
			min-height: 350px;
		}

		.hero-stats {
			flex-direction: column;
			gap: 1rem;
			padding: 1.5rem 2rem;
		}

		.stat-divider {
			width: 100%;
			height: 1px;
		}

		.pictures-grid {
			grid-template-columns: 1fr;
		}

		.picture-wrapper {
			aspect-ratio: 16/9;
		}

		.link-card-grid {
			max-width: 100%;
		}

		.posts-section,
		.daily-pictures-section {
			padding: 0 1rem 2rem;
		}

		.section-header {
			margin-bottom: 2rem;
		}

		.pagination {
			flex-direction: column;
			gap: 1rem;
		}

		.pagination-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<script is:inline>
	const POSTS_PER_PAGE = 5;
	let currentPage = 1;
	let totalPages = 1;
	let allPosts = [];

	// 分页功能
	function initPagination() {
		const postCards = document.querySelectorAll('.post-card');
		allPosts = Array.from(postCards);
		totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
		
		updatePaginationUI();
		showPage(1);
	}

	function showPage(page) {
		const startIndex = (page - 1) * POSTS_PER_PAGE;
		const endIndex = startIndex + POSTS_PER_PAGE;

		allPosts.forEach((post, index) => {
			if (index >= startIndex && index < endIndex) {
				post.style.display = '';
				post.style.opacity = '0';
				setTimeout(() => {
					post.style.opacity = '1';
				}, (index - startIndex) * 50);
			} else {
				post.style.display = 'none';
			}
		});

		currentPage = page;
		updatePaginationUI();
		
		// 滚动到文章列表顶部
		const postsGrid = document.getElementById('postsGrid');
		if (postsGrid) {
			postsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	}

	function updatePaginationUI() {
		const currentPageEl = document.getElementById('currentPage');
		const totalPagesEl = document.getElementById('totalPages');
		const prevBtn = document.getElementById('prevBtn');
		const nextBtn = document.getElementById('nextBtn');
		const pagination = document.getElementById('pagination');

		if (currentPageEl) currentPageEl.textContent = currentPage;
		if (totalPagesEl) totalPagesEl.textContent = totalPages;
		
		if (prevBtn) prevBtn.disabled = currentPage <= 1;
		if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
		
		// 如果只有一页或没有文章，隐藏分页
		if (pagination) {
			pagination.style.display = totalPages <= 1 ? 'none' : 'flex';
		}
	}

	// 绑定分页按钮事件
	const prevBtn = document.getElementById('prevBtn');
	const nextBtn = document.getElementById('nextBtn');

	if (prevBtn) {
		prevBtn.addEventListener('click', () => {
			if (currentPage > 1) {
				showPage(currentPage - 1);
			}
		});
	}

	if (nextBtn) {
		nextBtn.addEventListener('click', () => {
			if (currentPage < totalPages) {
				showPage(currentPage + 1);
			}
		});
	}

	// 初始化分页
	initPagination();

	// 搜索功能
	const searchInput = document.getElementById('searchInput');
	const clearSearchBtn = document.getElementById('clearSearch');
	const postsGrid = document.getElementById('postsGrid');

	if (searchInput && postsGrid && allPosts.length > 0) {
		searchInput.addEventListener('input', function(e) {
			const searchTerm = e.target.value.toLowerCase().trim();
			
			allPosts.forEach(card => {
				const title = card.dataset.title || '';
				const tags = card.dataset.tags || '';
				const description = card.dataset.description || '';
				
				const matchesTitle = title.includes(searchTerm);
				const matchesTags = tags.includes(searchTerm);
				const matchesDescription = description.includes(searchTerm);
				
				if (searchTerm === '' || matchesTitle || matchesTags || matchesDescription) {
					card.dataset.matchSearch = 'true';
				} else {
					card.dataset.matchSearch = 'false';
				}
			});

			// 更新搜索结果的总页数
			const matchedPosts = allPosts.filter(p => p.dataset.matchSearch !== 'false');
			totalPages = Math.ceil(matchedPosts.length / POSTS_PER_PAGE);
			
			// 显示第一页搜索结果
			showSearchResults(1, searchTerm);

			clearSearchBtn.style.display = searchTerm ? 'flex' : 'none';
		});

		clearSearchBtn.addEventListener('click', function() {
			searchInput.value = '';
			searchInput.dispatchEvent(new Event('input'));
			searchInput.focus();
		});

		searchInput.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				searchInput.value = '';
				searchInput.dispatchEvent(new Event('input'));
			}
		});
	}

	function showSearchResults(page, searchTerm) {
		const matchedPosts = allPosts.filter(p => p.dataset.matchSearch !== 'false');
		const startIndex = (page - 1) * POSTS_PER_PAGE;
		const endIndex = startIndex + POSTS_PER_PAGE;

		allPosts.forEach((post, index) => {
			const isMatch = post.dataset.matchSearch !== 'false';
			const isInPage = matchedPosts.indexOf(post) >= startIndex && matchedPosts.indexOf(post) < endIndex;
			
			if (isMatch && isInPage) {
				post.style.display = '';
				post.style.opacity = '1';
			} else {
				post.style.display = 'none';
			}
		});

		currentPage = page;
		updatePaginationUI();
	}
</script>

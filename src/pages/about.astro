---
import Layout from '../layouts/Layout.astro';
---

<Layout title="关于 - 帷幄" description="关于帷幄博客的技术栈和项目介绍。">
	<main>
		<div class="about-container">
			<h1>关于帷幄</h1>
			<p class="subtitle">基于 Astro 构建的现代博客</p>
			
			<div class="section">
				<h2>技术栈</h2>
				<div class="tech-list">
					<span class="tech-tag">Astro</span>
					<span class="tech-tag">TypeScript</span>
					<span class="tech-tag">Markdown</span>
					<span class="tech-tag">CSS Variables</span>
				</div>
			</div>

			<div class="section">
				<h2>特性</h2>
				<ul class="feature-list">
					<li>⚡ 极速加载 - 静态生成，零 JavaScript 运行时开销</li>
					<li>🌓 主题切换 - 支持亮色/暗色模式</li>
					<li>📱 响应式设计 - 完美适配各种屏幕</li>
					<li>🔍 文章搜索 - 支持标题、标签搜索</li>
					<li>📊 阅读进度 - 实时显示阅读进度</li>
					<li>🖼️ 每日一图 - 自动获取精美图片</li>
				</ul>
			</div>

			<div class="section">
				<h2>API 服务</h2>
				<div class="api-list">
				<div class="api-item">
					<strong>Waifu.pics</strong> - 动漫图片 API
				</div>
				<div class="api-item">
					<strong>GitHub + jsDelivr</strong> - 图床与 CDN 加速
				</div>
			</div>
		</div>

		<!-- Daily Pictures -->
		<div class="daily-pictures-section">
			<div class="pictures-grid">
				<div class="picture-card">
					<div class="picture-wrapper">
						<img id="dailyImage1" src="" alt="动漫图片1" loading="lazy" />
						<div class="loading-overlay" id="loading1">
							<div class="spinner"></div>
						</div>
					</div>
				</div>
				<div class="picture-card">
					<div class="picture-wrapper">
						<img id="dailyImage2" src="" alt="动漫图片2" loading="lazy" />
						<div class="loading-overlay" id="loading2">
							<div class="spinner"></div>
						</div>
					</div>
				</div>
				<div class="picture-card">
					<div class="picture-wrapper">
						<img id="dailyImage3" src="" alt="动漫图片3" loading="lazy" />
						<div class="loading-overlay" id="loading3">
							<div class="spinner"></div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="quote">
				<p>"运筹帷幄之中，决胜千里之外"</p>
			</div>
		</div>
	</main>
</Layout>

<style>
	main {
		max-width: 800px;
		margin: 0 auto;
		padding: 3rem 1.5rem;
	}

	.about-container {
		text-align: center;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		margin: 0 0 0.5rem 0;
		color: var(--c-text);
	}

	.subtitle {
		font-size: 1.1rem;
		color: var(--c-text-secondary);
		margin: 0 0 3rem 0;
	}

	.section {
		margin-bottom: 2.5rem;
		text-align: left;
	}

	.section h2 {
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--c-text);
		margin: 0 0 1rem 0;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--c-primary);
		display: inline-block;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.tech-tag {
		padding: 0.5rem 1rem;
		background: var(--c-card-bg);
		border: 1px solid var(--c-card-border);
		border-radius: 2rem;
		font-size: 0.9rem;
		color: var(--c-text);
		transition: all 0.2s ease;
	}

	.tech-tag:hover {
		border-color: var(--c-primary);
		transform: translateY(-2px);
	}

	.feature-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.feature-list li {
		padding: 0.75rem 1rem;
		background: var(--c-card-bg);
		border: 1px solid var(--c-card-border);
		border-radius: 0.5rem;
		color: var(--c-text-secondary);
		font-size: 0.95rem;
		transition: all 0.2s ease;
	}

	.feature-list li:hover {
		border-color: var(--c-primary);
		transform: translateX(4px);
	}

	.api-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.api-item {
		padding: 1rem;
		background: var(--c-card-bg);
		border: 1px solid var(--c-card-border);
		border-radius: 0.5rem;
		color: var(--c-text-secondary);
		font-size: 0.95rem;
	}

	.api-item strong {
		color: var(--c-primary);
		margin-right: 0.5rem;
	}

	.quote {
		margin-top: 3rem;
		padding: 2rem;
		background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dark));
		border-radius: 1rem;
		color: white;
	}

	.quote p {
		margin: 0;
		font-size: 1.25rem;
		font-style: italic;
	}

	/* Daily Pictures Section */
	.daily-pictures-section {
		padding: 2rem 0;
		max-width: 1200px;
		margin: 0 auto;
	}

	.pictures-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.picture-card {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		transition: all 0.3s ease;
	}

	.picture-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-2xl);
	}

	.picture-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 3/4;
		overflow: hidden;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	}

	.picture-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.5s ease;
	}

	.picture-card:hover .picture-wrapper img {
		transform: scale(1.05);
	}

	.loading-overlay {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
	}

	.spinner {
		width: 30px;
		height: 30px;
		border: 3px solid rgba(255, 255, 255, 0.3);
		border-top-color: white;
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	@media (max-width: 640px) {
		h1 {
			font-size: 2rem;
		}

		main {
			padding: 2rem 1rem;
		}
	}
</style>

<script is:inline>
	/**
	 * 加载单张图片（带重试机制）
	 * @param {string} imageId - img元素的ID
	 * @param {string} loadingId - 加载遮罩的ID
	 * @param {number} maxRetries - 最大重试次数
	 * @param {number} retryDelay - 重试延迟（毫秒）
	 */
	async function loadPicture(imageId, loadingId, maxRetries = 5, retryDelay = 3000) {
		const image = document.getElementById(imageId);
		const loading = document.getElementById(loadingId);

		async function fetchWithRetry(attempt) {
			try {
				const response = await fetch('https://api.waifu.pics/sfw/waifu');
				if (!response.ok) {
					throw new Error(`HTTP ${response.status}`);
				}
				const data = await response.json();
				
				if (data.url) {
					image.src = data.url;
					image.onload = () => {
						loading.style.display = 'none';
					};
					image.onerror = () => {
						if (attempt < maxRetries) {
							console.warn(`图片加载失败，正在重试 (${attempt}/${maxRetries})`);
							setTimeout(() => fetchWithRetry(attempt + 1), retryDelay * attempt);
						} else {
							console.error('图片加载失败，已达到最大重试次数');
						}
					};
				} else {
					throw new Error('API返回数据格式错误');
				}
			} catch (error) {
				console.warn(`获取图片失败 (${attempt}/${maxRetries}):`, error.message);
				if (attempt < maxRetries) {
					setTimeout(() => fetchWithRetry(attempt + 1), retryDelay * attempt);
				} else {
					console.error('获取图片失败，已达到最大重试次数');
				}
			}
		}

		fetchWithRetry(1);
	}

	// 页面加载时获取三张图片
	loadPicture('dailyImage1', 'loading1');
	loadPicture('dailyImage2', 'loading2');
	loadPicture('dailyImage3', 'loading3');
</script>
